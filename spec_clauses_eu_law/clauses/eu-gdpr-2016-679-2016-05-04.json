  "outputCatalog": {
    "backup-restore-record": {
      "kind": "procedure",
      "description": "Customer-owned evidence that backups are taken and restoration is checked; no quoin, quire or engineering-assurance command produces it."
    },
    "data-flow-model": {
      "kind": "record",
      "description": "Architecture connections with their declared data flows and classifications."
    },
    "dpia": {
      "kind": "document",
      "description": "Product-specific data protection impact assessment authored by people, with any residual-risk acceptance recorded by a named approver."
    },
    "privacy-by-default-settings": {
      "kind": "record",
      "description": "Customer-supplied record of declared default processing settings and data-minimisation choices; no toolchain producer."
    },
    "processing-access-control": {
      "kind": "record",
      "description": "`spec-objects-security` `security.role` and `security.permission` records the customer authors for the personal-data processing system, or customer-supplied evidence of who may process personal data and on whose instructions; the clause set defines no producer."
    },
    "records-of-processing": {
      "kind": "record",
      "description": "Controller or processor record of processing activities derived from the declared data-flow model."
    },
    "security-risk-records": {
      "kind": "record",
      "description": "`spec-objects-security` threat, risk, and control records."
    },
    "software-architecture": {
      "kind": "record",
      "description": "`spec-objects-architecture` `part`, `port`, `connection`, and `allocation` artifacts; ADR artifacts from `spec-artifacts-process`."
    },
    "training-record": {
      "kind": "procedure",
      "description": "Customer-owned training record."
    },
    "verification-records": {
      "kind": "record",
      "description": "`quire matrix` / `quoin matrix` results and `quoin evidence record`.",
      "producers": ["run"]
    },
    "written-procedure": {
      "kind": "procedure",
      "description": "Customer-owned written procedure."
    }
  },
